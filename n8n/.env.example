# Skopiuj do n8n/.env i uzupełnij. Plik .env nigdy nie trafia do repo.

# Wersja obrazu n8n dla bota (sprawdzona z botem; ten sam obraz co w innych kontenerach 2.41.6 na Macu)
N8N_VERSION=2.41.6

# Token bota z BotFather
TELEGRAM_BOT_TOKEN=
# ID grupy „Dom” (liczba ujemna, np. -100…)
TELEGRAM_CHAT_ID=
# ID użytkowników Telegrama: 🟦 (właściciel konta Google) i 🟩
TELEGRAM_ID_NIEBIESKI=
TELEGRAM_ID_ZIELONY=
# Adresy e-mail kont Google: 🟦 i 🟩
EMAIL_NIEBIESKI=
EMAIL_ZIELONY=

# Klucz Gemini API (płatny tier) i model z obsługą audio oraz structured output
GEMINI_API_KEY=
GEMINI_MODEL=
# Maksymalna liczba wywołań Gemini dziennie
GEMINI_DAILY_LIMIT=200

# ID kalendarzy: „Dom”, „Dom-TEST” i kalendarz 🟩 (podgląd)
DOM_CALENDAR_ID=
DOM_TEST_CALENDAR_ID=
PARTNER_CALENDAR_ID=
# test = zapis do „Dom-TEST”, prod = zapis do „Dom”
DOM_MODE=test

# Klient OAuth (typ Desktop) i refresh token z: node scripts/google-auth.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Strefa czasowa n8n i kontenera
GENERIC_TIMEZONE=Europe/London
TZ=Europe/London
